{
  // Fait pointer VS Code sur l'environnement virtuel du projet, pour que
  // "Run" et le terminal intégré utilisent le bon Python sans configuration.
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  }
}
